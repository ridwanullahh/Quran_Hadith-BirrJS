  display: flex; align-items: center; gap: 12px; cursor: pointer;
  transition: transform 0.1s ease, border-color 0.15s ease;
}
.quick-chip:active { transform: scale(0.96); border-color: var(--primary); }
.quick-num {
  width: 32px; height: 32px; flex-shrink: 0;
  background: var(--primary); color: #FFFFFF;
  border-radius: 50%; display: flex; align-items: center; justify-content: center;
  font-weight: 700; font-size: 13px;
}
.quick-info { display: flex; flex-direction: column; gap: 1px; min-width: 0; }
.quick-name { font-size: 14px; font-weight: 600; color: var(--text); }
.quick-arabic { font-size: 15px; color: var(--primary); font-family: 'Amiri', serif; }

/* ============ FILTER BAR ============ */
.filter-bar { margin-bottom: 16px; display: flex; flex-direction: column; gap: 10px; }
.search-box {
  display: flex; align-items: center; gap: 8px;
  background: var(--surface); border: 1px solid var(--border);
  border-radius: var(--radius-sm); padding: 0 12px;
  box-shadow: var(--shadow-sm);
}
.search-box-icon { color: var(--muted); display: flex; }
.search-box-input {
  flex: 1; border: none; background: transparent;
  padding: 12px 0; font-size: 15px; color: var(--text);
  font-family: inherit;
}
.search-box-input:focus { outline: none; }
.search-box-lg { padding: 0 14px; }
.search-box-clear {
  background: var(--border); border: none; color: var(--text);
  width: 28px; height: 28px; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  cursor: pointer;
}
.tab-group { display: flex; gap: 6px; }
.tab {
  flex: 1; padding: 8px 12px; border: 1px solid var(--border);
  background: var(--surface); color: var(--muted);
  border-radius: var(--radius-xs); font-size: 13px; font-weight: 600;
  cursor: pointer; transition: all 0.15s ease;
}
.tab-active { background: var(--primary); color: #FFFFFF; border-color: var(--primary); }

/* ============ SURAHS LIST ============ */
.surah-list { display: flex; flex-direction: column; gap: 8px; }
.surah-card {
  display: flex; align-items: center; gap: 14px; padding: 14px;
  background: var(--surface); border-radius: var(--radius-sm);
  border: 1px solid var(--border); cursor: pointer;
  box-shadow: var(--shadow-sm); transition: transform 0.1s ease, border-color 0.15s ease;
}
.surah-card:active { transform: scale(0.98); border-color: var(--primary); }
.surah-card-num {
  position: relative; width: 40px; height: 40px; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
}
.surah-card-num::before {
  content: ''; position: absolute; inset: 0;
  background: var(--primary-soft);
  transform: rotate(45deg);
  border-radius: 8px;
}
.surah-card-num-text {
  position: relative; z-index: 1;
  color: var(--primary); font-weight: 700; font-size: 14px;
}
.surah-card-body { flex: 1; min-width: 0; }
.surah-card-name { font-weight: 700; font-size: 15px; color: var(--text); }
.surah-card-meta { font-size: 12px; color: var(--muted); margin-top: 2px; }
.surah-card-arabic {
  font-size: 20px; color: var(--primary); flex-shrink: 0;
  font-family: 'Amiri', 'Scheherazade New', serif;
}
.empty-text { text-align: center; padding: 32px 16px; color: var(--muted); font-size: 14px; }

/* ============ SURAH READER ============ */
.reader-head {
  display: flex; align-items: center; gap: 12px; margin-bottom: 16px;
}
.reader-head-info { flex: 1; min-width: 0; }
.reader-head-name { font-size: 22px; font-weight: 800; margin: 0; color: var(--text); }
.reader-head-meta { font-size: 13px; color: var(--muted); margin: 2px 0 0 0; }
.reader-head-actions { display: flex; align-items: center; gap: 8px; }
.reciter-select {
  background: var(--surface); color: var(--text);
  border: 1px solid var(--border); border-radius: var(--radius-xs);
  padding: 8px 10px; font-size: 12px; font-weight: 600;
  max-width: 130px; cursor: pointer;
}
.play-all-btn {
  width: 100%; display: flex; align-items: center; justify-content: center; gap: 8px;
  background: var(--primary); color: #FFFFFF; border: none;
  border-radius: var(--radius-sm); padding: 12px;
  font-size: 14px; font-weight: 700; cursor: pointer;
  margin-bottom: 16px; box-shadow: var(--shadow-sm);
  transition: transform 0.1s ease;
}
.play-all-btn:active { transform: scale(0.98); }
.loading {
  display: flex; flex-direction: column; align-items: center; gap: 12px;
  padding: 48px 16px; color: var(--muted);
}
.spinner { animation: spin 1.2s linear infinite; display: flex; color: var(--primary); }
@keyframes spin { to { transform: rotate(360deg); } }
.bismillah-banner {
  text-align: center; padding: 24px 16px; margin-bottom: 16px;
  background: var(--primary-soft); border-radius: var(--radius);
  border: 1px solid var(--border);
}
.bismillah-banner p {
  font-size: 28px; color: var(--primary); margin: 0;
  font-family: 'Amiri', 'Scheherazade New', serif; font-weight: 600;
}
.ayah-list { display: flex; flex-direction: column; gap: 14px; }
.ayah-card {
  background: var(--surface); border-radius: var(--radius);
  padding: 18px; border: 1px solid var(--border);
  box-shadow: var(--shadow-sm);
}
.ayah-card-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px; }
.ayah-num-circle {
  width: 34px; height: 34px; border-radius: 50%;
