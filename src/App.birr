<template>
  <div class="app" birr:bind:data-theme="theme">
    <header class="header">
      <div class="header-inner">
        <div class="brand" birr:on:click="goHome">
          <span class="brand-mark" birr:bind:innerHTML="icon('book-open', { size: 22, color: '#FFFFFF' })"></span>
          <span class="brand-name">Quran <span class="brand-amp">&</span> Hadith</span>
        </div>
        <div class="header-actions">
          <div class="header-select-wrap" birr:if="showTranslationPicker">
            <span class="header-select-icon" birr:bind:innerHTML="icon('globe', { size: 14 })"></span>
            <select class="header-select" birr:on:change="onTranslationChange" birr:bind:value="currentTranslation">
              <option birr:for="tr in translations" birr:key="tr.code" value="{{ tr.code }}">{{ tr.name }}</option>
            </select>
          </div>
          <button class="icon-btn" birr:on:click="toggleTheme" aria-label="Toggle theme" birr:bind:innerHTML="themeIcon"></button>
        </div>
      </div>
    </header>

    <main class="main">
      <!-- ============ HOME ============ -->
      <div birr:if="isHome" class="page page-home">
        <section class="hero">
          <div class="hero-glow"></div>
          <p class="hero-bismillah">بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ</p>
          <p class="hero-bismillah-en">In the name of Allah, the Entirely Merciful, the Especially Merciful.</p>
          <div class="hero-divider"></div>
          <p class="hero-tagline">Read the Quran and the Sunnah, beautifully, offline.</p>
        </section>

        <section class="featured-surah" birr:on:click="openSurah(1)">
          <div class="featured-left">
            <span class="featured-label">Featured Surah</span>
            <h3 class="featured-name">Al-Fatihah</h3>
            <span class="featured-arabic">الفاتحة</span>
            <span class="featured-meta">The Opener - 7 verses - Meccan</span>
          </div>
          <div class="featured-right">
            <span class="featured-play" birr:bind:innerHTML="icon('play', { size: 24, color: '#FFFFFF' })"></span>
            <span class="featured-read">Read</span>
          </div>
        </section>

        <section class="home-cards">
          <div class="home-card home-card-quran" birr:on:click="goQuran">
            <div class="home-card-icon" birr:bind:innerHTML="icon('book-open', { size: 28 })"></div>
            <h3>Al-Quran</h3>
            <p>114 Surahs - 10 translations - Audio recitation</p>
            <span class="home-card-arrow" birr:bind:innerHTML="icon('arrow-right', { size: 16 })"></span>
          </div>
          <div class="home-card home-card-hadith" birr:on:click="goHadith">
            <div class="home-card-icon home-card-icon-gold" birr:bind:innerHTML="icon('file-text', { size: 28 })"></div>
            <h3>Hadith</h3>
            <p>6 canonical collections - 1200 hadiths</p>
            <span class="home-card-arrow" birr:bind:innerHTML="icon('arrow-right', { size: 16 })"></span>
          </div>
        </section>

        <section birr:if="dailyHadith" class="daily-section">
          <div class="section-head">
            <h3 class="section-title">Hadith of the Moment</h3>
            <span class="section-icon" birr:bind:innerHTML="icon('sparkles', { size: 16 })"></span>
          </div>
          <div class="daily-card" birr:on:click="openCollection(dailyHadith.collection)">
            <p class="daily-arabic">{{ dailyHadith.arabic }}</p>
            <p class="daily-english">{{ dailyHadith.english }}</p>
            <div class="daily-foot">
              <span class="daily-source">{{ dailyHadith.collection }} #{{ dailyHadith.number }}</span>
              <span birr:if="dailyHadith.grade" class="daily-grade">{{ dailyHadith.grade }}</span>
            </div>
          </div>
        </section>

        <section class="quick-section">
          <h3 class="section-title">Quick Access</h3>
          <div class="quick-grid">
            <div birr:for="s in quickSurahs" birr:key="s.number" class="quick-chip" birr:on:click="openSurah(s.number)">
              <span class="quick-num">{{ s.number }}</span>
              <div class="quick-info">
                <span class="quick-name">{{ s.transliteration }}</span>
                <span class="quick-arabic">{{ s.name }}</span>
              </div>
            </div>
          </div>
        </section>
      </div>

      <!-- ============ QURAN LIST ============ -->
      <div birr:if="isQuranList" class="page">
        <div class="page-head">
          <h2 class="page-title">Al-Quran</h2>
          <p class="page-subtitle">114 Surahs - Full Arabic text with translations and audio</p>
        </div>
        <div class="filter-bar">
          <div class="search-box">
            <span class="search-box-icon" birr:bind:innerHTML="icon('search', { size: 16 })"></span>
            <input class="search-box-input" placeholder="Find a surah..." birr:on:input="onSurahFilter" value="{{ surahFilter }}" />
          </div>
          <div class="tab-group">
            <button birr:for="tab in surahTabs" birr:key="tab.key" birr:bind:class="tab.cls" birr:on:click="setSurahTab(tab.key)">{{ tab.label }}</button>
          </div>
        </div>
        <div class="surah-list">
          <div birr:for="surah in filteredSurahs" birr:key="surah.number" class="surah-card" birr:on:click="openSurah(surah.number)">
            <div class="surah-card-num">
              <span class="surah-card-num-text">{{ surah.number }}</span>
            </div>
            <div class="surah-card-body">
              <div class="surah-card-name">{{ surah.transliteration }}</div>
              <div class="surah-card-meta">{{ surah.englishName }} - {{ surah.ayahs }} verses - {{ surah.type }}</div>
            </div>
            <div class="surah-card-arabic">{{ surah.name }}</div>
          </div>
          <p birr:if="filteredSurahs.length === 0" class="empty-text">No surahs match your search.</p>
        </div>
      </div>

      <!-- ============ SURAH READER ============ -->
      <div birr:if="isSurah" class="page">
        <div class="reader-head">
          <button class="icon-btn icon-btn-ghost" birr:on:click="goQuran" aria-label="Back" birr:bind:innerHTML="icon('arrow-left', { size: 20 })"></button>
          <div class="reader-head-info">
            <h2 class="reader-head-name">{{ currentSurahName }}</h2>
            <p class="reader-head-meta">{{ currentSurahType }} - {{ currentSurahAyahCount }} verses</p>
          </div>
          <div class="reader-head-actions">
            <select class="reciter-select" birr:on:change="onReciterChange" birr:bind:value="currentReciter">
              <option birr:for="r in reciters" birr:key="r.id" value="{{ r.id }}">{{ r.name }}</option>
            </select>
          </div>
        </div>

        <button birr:if="!isLoadingSurah" class="play-all-btn" birr:on:click="playWholeSurah">
          <span birr:bind:innerHTML="icon('play', { size: 16, color: '#FFFFFF' })"></span>
          <span>Play entire surah</span>
        </button>

        <div birr:if="isLoadingSurah" class="loading">
          <span class="spinner" birr:bind:innerHTML="icon('loader', { size: 28 })"></span>
          <p>Loading surah...</p>
        </div>

        <div birr:if="!isLoadingSurah" class="ayah-list">
          <div birr:if="showBismillah" class="bismillah-banner">
            <p>بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ</p>
          </div>
          <div birr:for="ayah in currentAyahs" birr:key="ayah.number" class="ayah-card" birr:bind:id="'ayah-' + ayah.number">
            <div class="ayah-card-top">
              <div class="ayah-num-circle">{{ ayah.number }}</div>
              <div class="ayah-card-actions">
                <button class="icon-btn icon-btn-sm" birr:on:click="playAyah(ayah.number)" aria-label="Play" birr:bind:innerHTML="icon('play', { size: 14 })"></button>
                <button class="icon-btn icon-btn-sm" birr:on:click="toggleBookmark(surahNumber, ayah.number)" aria-label="Bookmark" birr:bind:innerHTML="icon('bookmark', { size: 14 })"></button>
                <button class="icon-btn icon-btn-sm" birr:on:click="shareAyah(ayah.number)" aria-label="Share" birr:bind:innerHTML="icon('share', { size: 14 })"></button>
              </div>
            </div>
            <p class="ayah-arabic">{{ ayah.arabic }}</p>
            <p birr:if="ayah.transliteration" class="ayah-translit">{{ ayah.transliteration }}</p>
            <p class="ayah-translation">{{ ayahTranslation(ayah) }}</p>
          </div>
        </div>
      </div>

      <!-- ============ HADITH LIST ============ -->
      <div birr:if="isHadithList" class="page">
        <div class="page-head">
          <h2 class="page-title">Hadith Collections</h2>
          <p class="page-subtitle">The Six Canonical Books (Kutub as-Sittah) - 1200 hadiths</p>
        </div>
        <div class="collection-grid">
          <div birr:for="(col, i) in hadithCollections" birr:key="col.key" birr:bind:class="collectionClass(i)" birr:on:click="openCollection(col.key)">
            <div class="collection-icon-wrap">
              <span birr:bind:innerHTML="icon('book-open', { size: 26 })"></span>
            </div>
            <div class="collection-body">
              <h3 class="collection-name">{{ col.name }}</h3>
              <p class="collection-arabic">{{ col.arabicName }}</p>
              <p class="collection-count">{{ col.count }} hadiths</p>
            </div>
            <span class="collection-arrow" birr:bind:innerHTML="icon('chevron-right', { size: 18 })"></span>
          </div>
        </div>
      </div>

      <!-- ============ HADITH COLLECTION ============ -->
      <div birr:if="isHadithCollection" class="page">
        <div class="reader-head">
          <button class="icon-btn icon-btn-ghost" birr:on:click="goHadith" aria-label="Back" birr:bind:innerHTML="icon('arrow-left', { size: 20 })"></button>
          <div class="reader-head-info">
            <h2 class="reader-head-name">{{ currentCollectionName }}</h2>
            <p class="reader-head-meta">{{ currentHadithsCount }} hadiths</p>
          </div>
        </div>
        <div birr:if="currentHadithsCount > 0" class="filter-bar">
          <div class="search-box">
            <span class="search-box-icon" birr:bind:innerHTML="icon('search', { size: 16 })"></span>
            <input class="search-box-input" placeholder="Filter hadiths in this collection..." birr:on:input="onHadithFilter" value="{{ hadithFilter }}" />
          </div>
        </div>
        <div birr:if="currentHadithsCount === 0" class="loading">
          <span class="spinner" birr:bind:innerHTML="icon('loader', { size: 28 })"></span>
          <p>Loading hadiths...</p>
        </div>
        <div class="hadith-list">
          <div birr:for="hadith in filteredHadiths" birr:key="hadith.urn" class="hadith-card">
            <div class="hadith-card-head">
              <span class="hadith-num">#{{ hadith.number }}</span>
              <span birr:if="hadith.grade" class="hadith-grade">{{ hadith.grade }}</span>
              <button class="icon-btn icon-btn-sm hadith-save" birr:on:click="bookmarkHadith(hadith)" aria-label="Save" birr:bind:innerHTML="icon('bookmark', { size: 14 })"></button>
            </div>
            <p class="hadith-arabic">{{ hadith.arabic }}</p>
            <p class="hadith-english">{{ hadith.english }}</p>
            <p birr:if="hadith.narrator" class="hadith-narrator">Narrated by: {{ hadith.narrator }}</p>
          </div>
          <p birr:if="currentHadithsCount > 0 && filteredHadiths.length === 0" class="empty-text">No hadiths match your filter.</p>
        </div>
      </div>

      <!-- ============ SEARCH ============ -->
      <div birr:if="isSearch" class="page">
        <div class="page-head">
          <h2 class="page-title">Search</h2>
          <p class="page-subtitle">Search across all 6 hadith collections and loaded surahs</p>
        </div>
        <div class="search-box search-box-lg">
          <span class="search-box-icon" birr:bind:innerHTML="icon('search', { size: 18 })"></span>
          <input class="search-box-input" placeholder="Search for a word or phrase..." birr:on:input="onSearchInput" value="{{ searchQuery }}" />
          <button birr:if="searchQuery" class="search-box-clear" birr:on:click="clearSearch" birr:bind:innerHTML="icon('x', { size: 16 })"></button>
        </div>
        <div birr:if="isSearching" class="loading">
          <span class="spinner" birr:bind:innerHTML="icon('loader', { size: 24 })"></span>
          <p>Searching...</p>
        </div>
        <div birr:if="!isSearching && searchQuery" class="search-results">
          <p class="search-summary">{{ searchResults.length }} results</p>
          <div birr:for="result in searchResults" birr:key="result.id" class="result-card" birr:on:click="openSearchResult(result)">
            <div class="result-card-head">
              <span birr:bind:innerHTML="result.icon"></span>
              <span class="result-type">{{ result.type }}</span>
            </div>
            <p class="result-text">{{ result.text }}</p>
          </div>
          <p birr:if="searchResults.length === 0" class="empty-text">No results found. Try a different query.</p>
        </div>
        <div birr:if="!searchQuery" class="search-empty">
          <span class="search-empty-icon" birr:bind:innerHTML="icon('search', { size: 48 })"></span>
          <p>Type to search across Quran and Hadith.</p>
        </div>
      </div>

      <!-- ============ BOOKMARKS ============ -->
      <div birr:if="isBookmarks" class="page">
        <div class="page-head">
          <h2 class="page-title">Saved Items</h2>
          <p class="page-subtitle">{{ bookmarks.length }} saved - Stored locally with BirrDB</p>
        </div>
        <div birr:if="bookmarks.length === 0" class="empty-state">
          <span class="empty-state-icon" birr:bind:innerHTML="icon('bookmark', { size: 48 })"></span>
          <h3>No saved items yet</h3>
          <p>Bookmark ayahs and hadiths to find them here.</p>
        </div>
        <div birr:if="bookmarks.length > 0" class="bookmark-list">
          <div birr:for="bm in bookmarks" birr:key="bm.id" class="bookmark-card" birr:on:click="openBookmark(bm)">
            <div class="bookmark-card-head">
              <span class="bookmark-type">{{ bm.type }}</span>
              <button class="icon-btn icon-btn-sm" birr:on:click="deleteBookmark(bm.id)" aria-label="Remove" birr:bind:innerHTML="icon('trash', { size: 14 })"></button>
            </div>
            <p class="bookmark-label">{{ bm.label }}</p>
          </div>
        </div>
      </div>
    </main>

    <!-- ============ MINI AUDIO PLAYER ============ -->
    <div birr:if="currentPlaying" class="mini-player">
      <div class="mini-player-info">
        <span class="mini-player-surah">{{ currentPlaying.surahName }}</span>
        <span class="mini-player-ayah">Ayah {{ currentPlaying.ayah }}</span>
      </div>
      <div class="mini-player-controls">
        <button class="icon-btn icon-btn-sm" birr:on:click="stopAudio" aria-label="Stop" birr:bind:innerHTML="icon('x', { size: 16 })"></button>
        <button class="mini-player-play" birr:on:click="togglePlayPause" aria-label="Play/Pause" birr:bind:innerHTML="playPauseIcon"></button>
      </div>
    </div>

    <!-- ============ BOTTOM NAV ============ -->
    <nav class="bottom-nav">
      <button birr:bind:class="navHomeClass" birr:on:click="goHome">
        <span birr:bind:innerHTML="icon('home', { size: 22 })"></span>
        <span>Home</span>
      </button>
      <button birr:bind:class="navQuranClass" birr:on:click="goQuran">
        <span birr:bind:innerHTML="icon('book-open', { size: 22 })"></span>
        <span>Quran</span>
      </button>
      <button birr:bind:class="navHadithClass" birr:on:click="goHadith">
        <span birr:bind:innerHTML="icon('file-text', { size: 22 })"></span>
        <span>Hadith</span>
      </button>
      <button birr:bind:class="navSearchClass" birr:on:click="goSearch">
        <span birr:bind:innerHTML="icon('search', { size: 22 })"></span>
        <span>Search</span>
      </button>
      <button birr:bind:class="navBookmarksClass" birr:on:click="goBookmarks">
        <span birr:bind:innerHTML="icon('bookmark', { size: 22 })"></span>
        <span>Saved</span>
      </button>
    </nav>
  </div>
</template>

<script>
import { signal, computed, icon, createRouter, registerRouter } from 'birrstack-core';
import { TRANSLATIONS, RECITERS, loadSurah, getAyahAudioUrl, SURAHS_META } from './data/quran-service';
import { getCollections, getHadiths, searchHadiths, getRandomHadith } from './data/hadith-service';
import { getThemeSignal, toggleTheme } from './lib/theme';
import { getBookmarks, addBookmark, removeBookmark } from './lib/db';

const ALL_SURAHS = [];
for (let i = 1; i <= 114; i++) {
  const meta = SURAHS_META.find(s => s.number === i);
  if (meta) ALL_SURAHS.push(meta);
  else ALL_SURAHS.push({ number: i, name: '', transliteration: 'Surah ' + i, englishName: '', ayahs: 0, type: '' });
}

const COLLECTION_DISPLAY = {
  bukhari: 'Bukhari', muslim: 'Muslim', nasai: 'Nasai',
  abudawud: 'Abu Dawud', tirmidhi: 'Tirmidhi', ibnmajah: 'Ibn Majah',
};

export default {
  setup() {
    const theme = getThemeSignal();
    const themeIcon = computed(() => icon(theme.value === 'light' ? 'moon' : 'sun', { size: 20 }));

    // ----- Router (history mode, no # in URLs) -----
    const routeName = signal('home');
    const routeParams = signal({});

    const router = createRouter({
      mode: 'history',
      routes: [
        { path: '/', name: 'home' },
        { path: '/quran', name: 'quran-list' },
        { path: '/quran/:number', name: 'surah' },
        { path: '/hadith', name: 'hadith-list' },
        { path: '/hadith/:collection', name: 'hadith-collection' },
        { path: '/search', name: 'search' },
        { path: '/bookmarks', name: 'bookmarks' },
      ],
    });
    registerRouter(router);
    // NOTE: router.subscribe() is deferred to the end of setup() so that all
    // const-declared state (dailyHadith, currentAyahs, etc.) is initialized
    // before the subscription callback fires.

    // ----- Route flags -----
    const isHome = computed(() => routeName.value === 'home');
    const isQuranList = computed(() => routeName.value === 'quran-list');
    const isSurah = computed(() => routeName.value === 'surah');
    const isHadithList = computed(() => routeName.value === 'hadith-list');
    const isHadithCollection = computed(() => routeName.value === 'hadith-collection');
    const isSearch = computed(() => routeName.value === 'search');
    const isBookmarks = computed(() => routeName.value === 'bookmarks');

    const showTranslationPicker = computed(() => isQuranList.value || isSurah.value || isHome.value);

    const navHomeClass = computed(() => isHome.value ? 'nav-item nav-active' : 'nav-item');
    const navQuranClass = computed(() => (isQuranList.value || isSurah.value) ? 'nav-item nav-active' : 'nav-item');
    const navHadithClass = computed(() => (isHadithList.value || isHadithCollection.value) ? 'nav-item nav-active' : 'nav-item');
    const navSearchClass = computed(() => isSearch.value ? 'nav-item nav-active' : 'nav-item');
    const navBookmarksClass = computed(() => isBookmarks.value ? 'nav-item nav-active' : 'nav-item');

    // ----- Translations -----
    const translations = TRANSLATIONS;
    const currentTranslation = signal('en');
    function onTranslationChange(e) {
      currentTranslation.value = e.target.value;
      if (routeName.value === 'surah') loadSurahData(surahNumber.value);
    }

    // ----- Reciters -----
    const reciters = RECITERS;
    const currentReciter = signal('ar_alafasy');
    function onReciterChange(e) { currentReciter.value = e.target.value; }

    // ----- Quran data -----
    const allSurahs = ALL_SURAHS;
    const quickSurahs = [1, 36, 55, 56, 67, 18, 112, 113, 114, 2].map(n => ALL_SURAHS[n - 1]).filter(Boolean);
    const surahNumber = signal(1);
    const currentSurahNumber = computed(() => surahNumber.value);
    const currentSurahName = computed(() => {
      const s = ALL_SURAHS[surahNumber.value - 1];
      return s ? s.transliteration : '';
    });
    const currentSurahType = computed(() => {
      const s = ALL_SURAHS[surahNumber.value - 1];
      const t = s ? s.type : '';
      return t ? (t.charAt(0).toUpperCase() + t.slice(1)) : '';
    });
    const currentSurahAyahCount = computed(() => {
      const s = ALL_SURAHS[surahNumber.value - 1];
      return s ? s.ayahs : 0;
    });
    const showBismillah = computed(() => surahNumber.value !== 1 && surahNumber.value !== 9);
    const currentAyahs = signal([]);
    const isLoadingSurah = signal(false);

    async function loadSurahData(num) {
      surahNumber.value = num;
      isLoadingSurah.value = true;
      currentAyahs.value = [];
      try {
        const surah = await loadSurah(num, currentTranslation.value);
        currentAyahs.value = surah.ayahs;
      } catch (e) {
        console.error('Failed to load surah:', e);
      }
      isLoadingSurah.value = false;
    }

    function ayahTranslation(ayah) {
      const tr = ayah.translations || {};
      return tr[currentTranslation.value] || tr.en || '';
    }

    // ----- Surah list filter -----
    const surahFilter = signal('');
    const surahTab = signal('all');
    const surahTabs = computed(() => [
      { key: 'all', label: 'All', cls: surahTab.value === 'all' ? 'tab tab-active' : 'tab' },
      { key: 'meccan', label: 'Meccan', cls: surahTab.value === 'meccan' ? 'tab tab-active' : 'tab' },
      { key: 'medinan', label: 'Medinan', cls: surahTab.value === 'medinan' ? 'tab tab-active' : 'tab' },
    ]);
    function setSurahTab(key) { surahTab.value = key; }
    function onSurahFilter(e) { surahFilter.value = e.target.value; }
    const filteredSurahs = computed(() => {
      const q = surahFilter.value.toLowerCase().trim();
      const tab = surahTab.value;
      return ALL_SURAHS.filter(s => {
        if (tab === 'meccan' && s.type !== 'Meccan') return false;
        if (tab === 'medinan' && s.type !== 'Medinan') return false;
        if (!q) return true;
        return s.transliteration.toLowerCase().includes(q) ||
               s.englishName.toLowerCase().includes(q) ||
               s.name.includes(surahFilter.value);
      });
    });

    // ----- Audio player -----
    let currentAudio = null;
    const currentPlaying = signal(null);
    const playPauseIcon = computed(() => {
      if (!currentPlaying.value) return '';
      return icon(currentPlaying.value.isPlaying ? 'pause' : 'play', { size: 20, color: '#FFFFFF' });
    });

    function playAyah(ayahNum, opts) {
      if (currentAudio) { currentAudio.pause(); currentAudio = null; }
      const url = getAyahAudioUrl(surahNumber.value, ayahNum, currentReciter.value);
      currentAudio = new Audio(url);
      const s = ALL_SURAHS[surahNumber.value - 1];
      currentPlaying.value = {
        surah: surahNumber.value,
        surahName: s ? s.transliteration : '',
        ayah: ayahNum,
        isPlaying: true,
        autoAdvance: opts && opts.autoAdvance,
      };
      currentAudio.addEventListener('ended', () => {
        if (currentPlaying.value && currentPlaying.value.autoAdvance) {
          const next = ayahNum + 1;
          if (next <= currentSurahAyahCount.value) {
            playAyah(next, { autoAdvance: true });
            const el = document.getElementById('ayah-' + next);
            if (el) el.scrollIntoView({ behavior: 'smooth', block: 'center' });
          } else {
            stopAudio();
          }
        } else {
          stopAudio();
        }
      });
      currentAudio.addEventListener('error', () => {
        console.error('Audio error for ayah', ayahNum);
        stopAudio();
      });
      currentAudio.play().catch(e => {
        console.error('Audio play error:', e);
        stopAudio();
      });
    }

    function playWholeSurah() {
      if (currentAyahs.value.length === 0) return;
      playAyah(1, { autoAdvance: true });
    }

    function togglePlayPause() {
      if (!currentAudio || !currentPlaying.value) return;
      if (currentPlaying.value.isPlaying) {
        currentAudio.pause();
        currentPlaying.value = { ...currentPlaying.value, isPlaying: false };
      } else {
        currentAudio.play().catch(() => {});
        currentPlaying.value = { ...currentPlaying.value, isPlaying: true };
      }
    }

    function stopAudio() {
      if (currentAudio) { currentAudio.pause(); currentAudio = null; }
      currentPlaying.value = null;
    }

    function shareAyah(ayahNum) {
      const s = ALL_SURAHS[surahNumber.value - 1];
      const text = s ? s.transliteration + ' ' + ayahNum : 'Surah ' + surahNumber.value + ':' + ayahNum;
      if (navigator.share) {
        navigator.share({ title: 'Quran', text }).catch(() => {});
      } else if (navigator.clipboard) {
        navigator.clipboard.writeText(text).catch(() => {});
      }
    }

    // ----- Hadith data -----
    const hadithCollections = getCollections().map(c => ({ ...c, count: 200 }));
    const currentHadiths = signal([]);
    const currentHadithsCount = computed(() => currentHadiths.value.length);
    const currentCollectionName = computed(() => {
      const c = getCollections().find(col => col.key === routeParams.value.collection);
      return c ? c.name : '';
    });
    const hadithFilter = signal('');
    function onHadithFilter(e) { hadithFilter.value = e.target.value; }
    const filteredHadiths = computed(() => {
      const q = hadithFilter.value.toLowerCase().trim();
      if (!q) return currentHadiths.value;
      return currentHadiths.value.filter(h =>
        h.english.toLowerCase().includes(q) ||
        h.arabic.includes(hadithFilter.value) ||
        (h.narrator || '').toLowerCase().includes(q)
      );
    });

    async function loadCollectionData(key) {
      currentHadiths.value = [];
      hadithFilter.value = '';
      try {
        currentHadiths.value = await getHadiths(key);
      } catch (e) {
        console.error('Hadith load error:', e);
      }
    }

    function collectionClass(i) {
      const tones = ['col-tone-1', 'col-tone-2', 'col-tone-3', 'col-tone-4', 'col-tone-5', 'col-tone-6'];
      return 'collection-card ' + (tones[i % tones.length] || 'col-tone-1');
    }

    // ----- Daily hadith -----
    const dailyHadith = signal(null);
    async function loadDailyHadith() {
      if (dailyHadith.value) return;
      try {
        const { collection, hadith } = await getRandomHadith();
        dailyHadith.value = { ...hadith, collection: COLLECTION_DISPLAY[collection] || collection };
      } catch (e) {
        console.error('Daily hadith error:', e);
      }
    }

    // ----- Search -----
    const searchQuery = signal('');
    const searchResults = signal([]);
    const isSearching = signal(false);
    let searchTimer = null;

    async function onSearchInput(e) {
      const q = e.target.value;
      searchQuery.value = q;
      if (searchTimer) clearTimeout(searchTimer);
      if (!q.trim()) { searchResults.value = []; isSearching.value = false; return; }
      isSearching.value = true;
      searchTimer = setTimeout(async () => {
        try {
          const hadithResults = (await searchHadiths(q)).map(r => ({
            id: 'h-' + r.hadith.urn,
            type: 'Hadith - ' + (COLLECTION_DISPLAY[r.collection] || r.collection) + ' #' + r.hadith.number,
            text: r.hadith.english.slice(0, 160) + '...',
            icon: icon('file-text', { size: 16 }),
            action: () => router.push('/hadith/' + r.collection),
          }));
          searchResults.value = hadithResults;
        } catch (err) {
          console.error('Search error:', err);
          searchResults.value = [];
        }
        isSearching.value = false;
      }, 300);
    }

    function clearSearch() {
      searchQuery.value = '';
      searchResults.value = [];
    }

    function openSearchResult(result) {
      if (result.action) result.action();
    }

    // ----- Bookmarks -----
    const bookmarks = signal([]);

    async function loadBookmarks() {
      try { bookmarks.value = await getBookmarks(); }
      catch (e) { bookmarks.value = []; }
    }

    async function toggleBookmark(sNum, aNum) {
      try {
        const meta = ALL_SURAHS[sNum - 1];
        const label = (meta && meta.transliteration ? meta.transliteration : 'Surah') + ' ' + sNum + ':' + aNum;
        const bms = await getBookmarks();
        const existing = bms.find(b => b.type === 'ayah' && b.surahNumber === sNum && b.ayahNumber === aNum);
        if (existing) {
          await removeBookmark(existing.id);
        } else {
          await addBookmark({ type: 'ayah', surahNumber: sNum, ayahNumber: aNum, label });
        }
        loadBookmarks();
      } catch (e) { console.error('Bookmark error:', e); }
    }

    async function bookmarkHadith(hadith) {
      try {
        const col = routeParams.value.collection || 'hadith';
        const label = (COLLECTION_DISPLAY[col] || col) + ' #' + hadith.number + ' - ' + (hadith.english || '').slice(0, 60) + '...';
        const bms = await getBookmarks();
        const existing = bms.find(b => b.type === 'hadith' && b.hadithId === hadith.urn);
        if (existing) {
          await removeBookmark(existing.id);
        } else {
          await addBookmark({ type: 'hadith', hadithId: hadith.urn, label });
        }
        loadBookmarks();
      } catch (e) { console.error('Hadith bookmark error:', e); }
    }

    async function deleteBookmark(id) {
      await removeBookmark(id);
      loadBookmarks();
    }

    function openBookmark(bm) {
      if (bm.type === 'ayah') router.push('/quran/' + bm.surahNumber);
      else if (bm.type === 'hadith' && bm.hadithId) {
        // Navigate to the collection if we can infer it, else hadith list
        router.push('/hadith');
      }
    }

    // ----- Navigation -----
    function goHome() { router.push('/'); }
    function goQuran() { router.push('/quran'); }
    function goHadith() { router.push('/hadith'); }
    function goSearch() { router.push('/search'); }
    function goBookmarks() { router.push('/bookmarks'); }
    function openSurah(num) { router.push('/quran/' + num); }
    function openCollection(key) { router.push('/hadith/' + key); }

    // ----- Wire up the router (deferred from above so all state is initialized) -----
    router.subscribe((loc) => {
      if (!loc) return;
      const name = (loc.name === 'not-found') ? 'home' : (loc.name || 'home');
      routeName.value = name;
      routeParams.value = loc.params || {};
      if (name === 'home') loadDailyHadith();
      else if (name === 'surah' && loc.params && loc.params.number) loadSurahData(Number(loc.params.number));
      else if (name === 'hadith-collection' && loc.params && loc.params.collection) loadCollectionData(loc.params.collection);
      else if (name === 'bookmarks') loadBookmarks();
      if (typeof window !== 'undefined') window.scrollTo(0, 0);
    });

    return {
      theme, themeIcon, toggleTheme,
      showTranslationPicker,
      isHome, isQuranList, isSurah, isHadithList, isHadithCollection, isSearch, isBookmarks,
      navHomeClass, navQuranClass, navHadithClass, navSearchClass, navBookmarksClass,
      translations, currentTranslation, onTranslationChange,
      reciters, currentReciter, onReciterChange,
      allSurahs, quickSurahs, surahNumber, currentSurahNumber, currentSurahName, currentSurahType, currentSurahAyahCount,
      showBismillah, currentAyahs, isLoadingSurah, openSurah, ayahTranslation,
      surahFilter, surahTabs, setSurahTab, onSurahFilter, filteredSurahs,
      playAyah, playWholeSurah, togglePlayPause, stopAudio, shareAyah,
      currentPlaying, playPauseIcon,
      hadithCollections, currentHadiths, currentHadithsCount, currentCollectionName, openCollection, collectionClass,
      hadithFilter, onHadithFilter, filteredHadiths,
      dailyHadith,
      searchQuery, searchResults, isSearching, onSearchInput, openSearchResult, clearSearch,
      bookmarks, loadBookmarks, toggleBookmark, bookmarkHadith, deleteBookmark, openBookmark,
      goHome, goQuran, goHadith, goSearch, goBookmarks,
      icon,
    };
  },
};
</script>

<style scoped>
/* ============ DESIGN TOKENS ============ */
.app {
  --primary: #05B34D;
  --accent: #F2B91C;
  --bg: #E9FBF1;
  --surface: #FFFFFF;
  --text: #181F25;
  --muted: #5a6c6a;
  --border: #d1e8db;
  --primary-soft: rgba(5, 179, 77, 0.08);
  --accent-soft: rgba(242, 185, 28, 0.10);
  --shadow-sm: 0 1px 3px rgba(24, 31, 37, 0.06);
  --shadow-md: 0 4px 16px rgba(24, 31, 37, 0.08);
  --shadow-lg: 0 12px 32px rgba(24, 31, 37, 0.12);
  --radius: 18px;
  --radius-sm: 12px;
  --radius-xs: 8px;
  min-height: 100vh;
  background: var(--bg);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', sans-serif;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}
.app[data-theme="dark"] {
  --bg: #181F25;
  --surface: #232b32;
  --text: #E9FBF1;
  --muted: #8898a0;
  --border: #2d3a44;
  --primary-soft: rgba(5, 179, 77, 0.14);
  --accent-soft: rgba(242, 185, 28, 0.14);
  --shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.3);
  --shadow-md: 0 4px 16px rgba(0, 0, 0, 0.35);
  --shadow-lg: 0 12px 32px rgba(0, 0, 0, 0.45);
}

/* ============ HEADER ============ */
.header {
  position: sticky; top: 0; z-index: 100;
  background: var(--primary);
  box-shadow: var(--shadow-sm);
}
.app[data-theme="dark"] .header { background: #1a2620; }
.header-inner {
  display: flex; align-items: center; justify-content: space-between;
  height: 60px; max-width: 720px; margin: 0 auto; padding: 0 16px;
}
.brand { display: flex; align-items: center; gap: 10px; cursor: pointer; }
.brand-mark {
  width: 36px; height: 36px;
  background: rgba(255,255,255,0.18);
  border-radius: 10px;
  display: flex; align-items: center; justify-content: center;
}
.brand-name {
  color: #FFFFFF; font-size: 17px; font-weight: 700; letter-spacing: -0.01em;
}
.brand-amp { color: var(--accent); font-weight: 400; }
.header-actions { display: flex; align-items: center; gap: 8px; }
.header-select-wrap {
  display: flex; align-items: center; gap: 4px;
  background: rgba(255,255,255,0.15); border-radius: var(--radius-xs);
  padding: 0 8px;
}
.header-select-icon { color: #FFFFFF; opacity: 0.8; display: flex; }
.header-select {
  background: transparent; color: #FFFFFF; border: none;
  font-size: 12px; font-weight: 600; padding: 6px 0;
  max-width: 100px; cursor: pointer;
}
.header-select option { color: #181F25; }
.icon-btn {
  background: rgba(255,255,255,0.15); border: none; color: #FFFFFF;
  width: 36px; height: 36px; border-radius: 10px;
  display: flex; align-items: center; justify-content: center;
  cursor: pointer; transition: background 0.15s ease;
  -webkit-tap-highlight-color: transparent;
}
.icon-btn:active { background: rgba(255,255,255,0.28); }
.icon-btn-ghost {
  background: var(--primary-soft); color: var(--primary);
}
.icon-btn-ghost:active { background: var(--border); }
.icon-btn-sm {
  width: 30px; height: 30px; border-radius: 8px;
  background: var(--primary-soft); color: var(--muted);
}
.icon-btn-sm:active { background: var(--border); color: var(--primary); }

/* ============ MAIN ============ */
.main {
  max-width: 720px; margin: 0 auto; padding: 16px;
  padding-bottom: 140px;
}
.page { animation: fadeIn 0.25s ease; }
@keyframes fadeIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }
.page-head { margin-bottom: 20px; }
.page-title { font-size: 26px; font-weight: 800; color: var(--text); margin: 0; letter-spacing: -0.02em; }
.page-subtitle { font-size: 14px; color: var(--muted); margin: 4px 0 0 0; }

/* ============ HOME: HERO ============ */
.hero {
  position: relative; overflow: hidden;
  background: linear-gradient(135deg, var(--primary) 0%, #04a045 100%);
  border-radius: var(--radius); padding: 36px 24px; text-align: center;
  margin-bottom: 20px; box-shadow: var(--shadow-md);
}
.app[data-theme="dark"] .hero { background: linear-gradient(135deg, #1a2620 0%, #04a045 100%); }
.hero-glow {
  position: absolute; top: -40px; right: -40px;
  width: 160px; height: 160px;
  background: radial-gradient(circle, rgba(242,185,28,0.25) 0%, transparent 70%);
  border-radius: 50%; pointer-events: none;
}
.hero-bismillah {
  font-size: 32px; color: #FFFFFF; margin: 0 0 8px 0;
  font-weight: 600; line-height: 1.4; direction: rtl;
  font-family: 'Amiri', 'Scheherazade New', 'Traditional Arabic', serif;
}
.hero-bismillah-en { font-size: 13px; color: rgba(255,255,255,0.85); margin: 0; font-style: italic; }
.hero-divider {
  width: 40px; height: 2px; background: var(--accent);
  margin: 16px auto; border-radius: 1px;
}
.hero-tagline { font-size: 14px; color: rgba(255,255,255,0.9); margin: 0; }

/* ============ HOME: FEATURED ============ */
.featured-surah {
  background: var(--surface); border-radius: var(--radius);
  padding: 20px; margin-bottom: 20px;
  display: flex; align-items: center; justify-content: space-between;
  cursor: pointer; box-shadow: var(--shadow-sm);
  border: 1px solid var(--border); transition: transform 0.15s ease, box-shadow 0.15s ease;
}
.featured-surah:active { transform: scale(0.98); box-shadow: var(--shadow-md); }
.featured-left { display: flex; flex-direction: column; gap: 2px; }
.featured-label { font-size: 11px; color: var(--accent); font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; }
.featured-name { font-size: 20px; font-weight: 800; color: var(--text); margin: 0; }
.featured-arabic { font-size: 22px; color: var(--primary); font-family: 'Amiri', 'Scheherazade New', serif; }
.featured-meta { font-size: 12px; color: var(--muted); }
.featured-right {
  display: flex; flex-direction: column; align-items: center; gap: 6px;
}
.featured-play {
  width: 48px; height: 48px; border-radius: 50%;
  background: var(--primary); display: flex; align-items: center; justify-content: center;
  box-shadow: 0 4px 12px rgba(5, 179, 77, 0.35);
}
.featured-read { font-size: 11px; color: var(--muted); font-weight: 600; }

/* ============ HOME: CARDS ============ */
.home-cards { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 24px; }
.home-card {
  position: relative; background: var(--surface);
  border-radius: var(--radius); padding: 20px 16px;
  cursor: pointer; border: 1px solid var(--border);
  box-shadow: var(--shadow-sm); transition: transform 0.15s ease, box-shadow 0.15s ease;
  overflow: hidden;
}
.home-card:active { transform: scale(0.97); box-shadow: var(--shadow-md); }
.home-card-icon {
  width: 48px; height: 48px; border-radius: 12px;
  background: var(--primary-soft); color: var(--primary);
  display: flex; align-items: center; justify-content: center; margin-bottom: 12px;
}
.home-card-icon-gold { background: var(--accent-soft); color: var(--accent); }
.home-card h3 { font-size: 17px; font-weight: 700; color: var(--text); margin: 0 0 4px 0; }
.home-card p { font-size: 12px; color: var(--muted); margin: 0; line-height: 1.4; }
.home-card-arrow {
  position: absolute; top: 16px; right: 16px;
  color: var(--muted); opacity: 0.5;
}

/* ============ SECTION HEAD ============ */
.section-head { display: flex; align-items: center; gap: 8px; margin-bottom: 12px; }
.section-title { font-size: 16px; font-weight: 700; color: var(--text); margin: 0; }
.section-icon { color: var(--accent); display: flex; }

/* ============ HOME: DAILY HADITH ============ */
.daily-section { margin-bottom: 24px; }
.daily-card {
  background: var(--surface); border-radius: var(--radius);
  padding: 18px; cursor: pointer;
  border: 1px solid var(--border); box-shadow: var(--shadow-sm);
  border-left: 4px solid var(--accent);
  transition: transform 0.15s ease;
}
.daily-card:active { transform: scale(0.98); }
.daily-arabic {
  font-size: 18px; line-height: 1.9; text-align: right; color: var(--text);
  margin: 0 0 12px 0; direction: rtl;
  font-family: 'Amiri', 'Scheherazade New', serif;
}
.daily-english { font-size: 14px; line-height: 1.6; color: var(--text); margin: 0 0 12px 0; }
.daily-foot { display: flex; align-items: center; justify-content: space-between; }
.daily-source { font-size: 12px; color: var(--accent); font-weight: 700; }
.daily-grade {
  font-size: 11px; color: var(--primary); font-weight: 600;
  background: var(--primary-soft); padding: 2px 8px; border-radius: 4px;
}

/* ============ HOME: QUICK ACCESS ============ */
.quick-section { margin-bottom: 8px; }
.quick-section .section-title { margin-bottom: 12px; }
.quick-grid {
  display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px;
}
.quick-chip {
  background: var(--surface); border: 1px solid var(--border);
