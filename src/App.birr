/* ============ MINI PLAYER ============ */
.mini-player {
  position: fixed; bottom: 64px; left: 0; right: 0; z-index: 99;
  background: var(--surface); border-top: 1px solid var(--border);
  border-bottom: 1px solid var(--border);
  max-width: 720px; margin: 0 auto;
  display: flex; align-items: center; justify-content: space-between;
  padding: 10px 16px; box-shadow: var(--shadow-md);
  animation: slideUp 0.2s ease;
}
@keyframes slideUp { from { transform: translateY(100%); } to { transform: translateY(0); } }
.mini-player-info { display: flex; flex-direction: column; gap: 1px; min-width: 0; }
.mini-player-surah { font-size: 14px; font-weight: 700; color: var(--text); }
.mini-player-ayah { font-size: 12px; color: var(--muted); }
.mini-player-controls { display: flex; align-items: center; gap: 8px; }
.mini-player-play {
